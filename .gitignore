# Sensitive or machine-local project data. Keep only directory placeholders.
data/inputs/*
!data/inputs/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Generated human-facing artifacts.
outputs/assignments/*
!outputs/assignments/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/evaluations/*
!outputs/evaluations/.gitkeep

# Historical data can still contain names, email addresses, or paper records.
archive/retired-identity-resolution/*
!archive/retired-identity-resolution/.gitkeep
archive/historical-snapshots/*
!archive/historical-snapshots/.gitkeep

# Belt and braces. The rules above are location-based, so a sensitive file
# dropped anywhere but its usual directory would not be caught by them. These
# match on name wherever the file lands, which is what the pre-restructure
# .gitignore did for everything; real PC identities have leaked from this repo
# once already and the cost of a redundant rule is nothing.
*PC Member Acceptance Form*
*Area Chair Acceptance Form*
*TRC Member Acceptance Form*
hpca2027-pcinfo.csv
hpca2027-data*.json
hpca2027-trc*.csv
# The action log is the most sensitive file here: it carries an IP address and
# a timestamp for every action every PC member and author has ever taken.
hpca2027-log*.csv
reviewer_activity.csv
reviewers_pinned.txt
current_assignment*.csv
assignment-rerun*.csv
trc_dblp_overrides.csv
